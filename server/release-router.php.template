<?php
declare(strict_types=1);
// Immutable, release-specific entry point. Generated by strato_release_publish.py.
ini_set('display_errors', '0');
header('X-Content-Type-Options: nosniff');
$release = '@@RELEASE@@';
$previewHash = '@@PREVIEW_HASH@@';
$relative = $_GET['path'] ?? '';
if (!is_string($relative) || !preg_match('~^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$~D', $relative)
    || str_contains($relative, '..') || str_ends_with(strtolower($relative), '.php')) {
    http_response_code(404); exit;
}
$rules = file_get_contents(__DIR__ . '/.htaccess');
$active = is_string($rules) && str_starts_with($rules, '# NIC-RELEASE: ' . $release . "\n");
$oldAsset = is_string($rules) && preg_match('~^[A-Za-z0-9_-][A-Za-z0-9_.-]*\.[a-f0-9]{16}\.(?:js|css)$~D', $relative)
    && str_contains($rules, "\n# NIC-OLD-ROUTER: nic-release-" . $release . ".php\n");
$preview = hash_equals($previewHash, hash('sha256', $_SERVER['HTTP_X_NIC_PREVIEW_TOKEN'] ?? ''));
if (!$active && !$preview && !$oldAsset) { http_response_code(404); exit; }
if ($preview) {
    header('Cache-Control: no-store, private');
    header('X-Robots-Tag: noindex, nofollow');
}
try {
    $root = __DIR__ . '/.nic-releases/' . $release;
    $manifest = json_decode(file_get_contents($root . '/.ready.json'), true, 32, JSON_THROW_ON_ERROR);
    $meta = $manifest['files'][$relative] ?? null;
    if (!is_array($meta) || ($manifest['release'] ?? '') !== $release) { http_response_code(404); exit; }
    $realRoot = realpath($root);
    $file = realpath($root . '/' . $relative);
    if ($realRoot === false || $file === false || !str_starts_with($file, $realRoot . '/') || !is_file($file)) {
        http_response_code(404); exit;
    }
    // Check the actual selected source, independently of its filtered HTML output.
    $sourceHash = hash_file('sha256', $file);
    if (!is_string($sourceHash) || !hash_equals($meta['sha256'], $sourceHash)) {
        throw new RuntimeException('Release integrity failure');
    }
    header('X-NIC-Release: ' . $release);
    header('X-NIC-Source-SHA256: ' . $sourceHash);
    $extension = strtolower(pathinfo($relative, PATHINFO_EXTENSION));
    if ($extension === 'html') {
        define('NIC_CONTENT_ROOT', $root);
        define('NIC_PUBLIC_ROOT', __DIR__);
        require $root . '/content-gate.php';
        exit;
    }
    $types = ['js'=>'text/javascript; charset=utf-8', 'css'=>'text/css; charset=utf-8',
        'json'=>'application/json; charset=utf-8', 'svg'=>'image/svg+xml', 'png'=>'image/png',
        'jpg'=>'image/jpeg', 'jpeg'=>'image/jpeg', 'webp'=>'image/webp', 'gif'=>'image/gif',
        'avif'=>'image/avif', 'ico'=>'image/x-icon', 'woff'=>'font/woff', 'woff2'=>'font/woff2',
        'ttf'=>'font/ttf', 'txt'=>'text/plain; charset=utf-8', 'xml'=>'application/xml',
        'webmanifest'=>'application/manifest+json', 'pdf'=>'application/pdf', 'map'=>'application/json'];
    if (!isset($types[$extension])) { http_response_code(404); exit; }
    header('Content-Type: ' . $types[$extension]);
    if (!$preview) header('Cache-Control: no-cache');
    if ($relative === 'service-worker.js') header('Service-Worker-Allowed: /');
    if ($_SERVER['REQUEST_METHOD'] !== 'HEAD') readfile($file);
} catch (Throwable $error) {
    error_log('ImmoCheck release router failure: ' . get_class($error));
    http_response_code(503);
    echo 'Vorübergehend nicht verfügbar';
}
